{
  "name": "memestone",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:connection": "node scripts/check-live-connection.mjs",
    "test:editor": "vitest run src/game/custom-cards.test.ts src/game/warrior.test.ts src/online/protocol.test.ts",
    "test:warrior": "vitest run src/game/warrior.test.ts src/online/protocol.test.ts",
    "test:warrior-ui": "node scripts/check-warrior.mjs",
    "test:warrior-rooms": "WARRIOR=1 node scripts/check-live-connection.mjs",
    "test:hero-effects": "vitest run src/game/friendly-targets.test.ts src/game/discover.test.ts src/game/warrior.test.ts",
    "test:hero-effects-ui": "node scripts/check-hero-effects.mjs",
    "test:decks": "vitest run src/game/warlock.test.ts src/decks.test.ts src/online/protocol.test.ts",
    "test:decks-ui": "node scripts/check-decks.mjs",
    "test:decks-rooms": "CLASS_DECKS=1 node scripts/check-live-connection.mjs",
    "test:storm": "vitest run src/game/storm.test.ts src/decks.test.ts src/online/protocol.test.ts src/online/card-transfer.test.ts",
    "test:storm-ui": "node scripts/check-storm.mjs",
    "test:storm-rooms": "STORM=1 node scripts/check-live-connection.mjs",
    "test:editor-ui": "node scripts/check-editor.mjs",
    "test:custom-rooms": "CUSTOM_CARDS=1 node scripts/check-live-connection.mjs",
    "rooms:signaling": "node scripts/signaling.mjs",
    "test:cat": "vitest run src/game/cat.test.ts src/decks.test.ts",
    "test:cat-ui": "node scripts/check-cat.mjs",
    "test:card-update": "vitest run src/game/incinerate.test.ts src/game/class-cards.test.ts src/game/stealth.test.ts src/game/bulky.test.ts src/decks.test.ts",
    "test:card-update-ui": "node scripts/check-card-update.mjs",
    "test:tigerra": "vitest run src/game/tigerra.test.ts",
    "test:tigerra-ui": "node scripts/check-tigerra.mjs"
  },
  "dependencies": {
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "lucide-react": "^0.468.0",
    "mqtt": "^5.16.1",
    "peerjs": "^1.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "https-proxy-agent": "^9.1.0",
    "node-turn": "^0.0.6",
    "peer": "^1.0.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5",
    "ws": "^8.22.0"
  }
}
