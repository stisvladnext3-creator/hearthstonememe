{
  "name": "memestone",
  "private": true,
  "version": "0.24.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:connection": "node scripts/check-live-connection.mjs",
    "test:editor": "vitest run src/game/custom-cards.test.ts src/game/warrior.test.ts src/online/protocol.test.ts",
    "test:warrior": "vitest run src/game/warrior.test.ts src/online/protocol.test.ts",
    "test:warrior-ui": "node scripts/check-warrior.mjs",
    "test:warrior-rooms": "WARRIOR=1 node scripts/check-live-connection.mjs",
    "test:hero-effects": "vitest run src/game/friendly-targets.test.ts src/game/discover.test.ts src/game/warrior.test.ts",
    "test:hero-effects-ui": "node scripts/check-hero-effects.mjs",
    "test:decks": "vitest run src/game/warlock.test.ts src/decks.test.ts src/online/protocol.test.ts",
    "test:decks-ui": "node scripts/check-decks.mjs",
    "test:decks-rooms": "CLASS_DECKS=1 node scripts/check-live-connection.mjs",
    "test:storm": "vitest run src/game/storm.test.ts src/decks.test.ts src/online/protocol.test.ts src/online/card-transfer.test.ts",
    "test:storm-ui": "node scripts/check-storm.mjs",
    "test:storm-rooms": "STORM=1 node scripts/check-live-connection.mjs",
    "test:editor-ui": "node scripts/check-editor.mjs",
    "test:custom-rooms": "CUSTOM_CARDS=1 node scripts/check-live-connection.mjs",
    "rooms:signaling": "node scripts/signaling.mjs",
    "test:cat": "vitest run src/game/cat.test.ts src/decks.test.ts",
    "test:cat-ui": "node scripts/check-cat.mjs",
    "test:card-update": "vitest run src/game/incinerate.test.ts src/game/class-cards.test.ts src/game/stealth.test.ts src/game/bulky.test.ts src/decks.test.ts",
    "test:card-update-ui": "node scripts/check-card-update.mjs",
    "test:tigerra": "vitest run src/game/tigerra.test.ts",
    "test:tigerra-ui": "node scripts/check-tigerra.mjs",
    "test:profile": "vitest run src/game/metrics.test.ts",
    "test:keywords": "vitest run src/game/new-keywords.test.ts src/game/battle-keywords.test.ts src/game/metrics.test.ts src/game/training-bots.test.ts",
    "test:training": "vitest run src/game/training-bots.test.ts src/game/image-view.test.ts",
    "test:deck-publication": "vitest run src/community/library.test.ts",
    "test:community": "vitest run src/game/battle-keywords.test.ts src/community/library.test.ts src/game/metrics.test.ts",
    "test:battle-visuals": "vitest run src/game/card-play.test.ts src/game/battle-timeline.test.ts src/game/new-keywords.test.ts src/game/metrics.test.ts",
    "test:battle-visuals-ui": "node scripts/check-battle-visuals.mjs",
    "test:cast-rooms": "node scripts/check-cast-rooms.mjs",
    "test:accounts": "vitest run src/account/model.test.ts src/account/api.test.ts src/decks.test.ts src/game/metrics.test.ts",
    "test:account-server": "node scripts/check-account-server.mjs",
    "test:accounts-ui": "node scripts/check-accounts.mjs",
    "test:session-transport": "node scripts/check-session-transport.mjs",
    "test:card-media": "vitest run src/game/play-media.test.ts src/game/card-play.test.ts src/game/battle-timeline.test.ts src/game/custom-cards.test.ts src/online/protocol.test.ts src/account/model.test.ts",
    "test:card-media-ui": "node scripts/check-card-media.mjs",
    "test:card-media-rooms": "CARD_MEDIA=1 node scripts/check-cast-rooms.mjs",
    "test:boards-ui": "node scripts/check-board-picker.mjs",
    "test:card-preview-ui": "node scripts/check-card-preview.mjs"
  },
  "dependencies": {
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "lucide-react": "^0.468.0",
    "mqtt": "^5.16.1",
    "peerjs": "^1.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "https-proxy-agent": "^9.1.0",
    "node-turn": "^0.0.6",
    "peer": "^1.0.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5",
    "ws": "^8.22.0"
  }
}
